# SastoukaStore — exemple de configuration
# Copiez ce fichier vers .env puis renseignez vos vraies valeurs.
#
# IMPORTANT :
# - Ne publiez jamais .env dans GitHub.
# - Ne mettez jamais de vrai secret dans ce fichier.
# - Pour le compte administrateur, CHARIOW_ADMIN_HASH est un SHA-256
#   calculé selon la logique actuelle de admin_auth.py :
#   SHA256(SASTOUKASTORE_ADMIN_SALT + mot_de_passe)

# Clé secrète Flask / session
CHARIOW_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Cookie de session sécurisé :
# 0 = développement local HTTP
# 1 = HTTPS uniquement
CHARIOW_SESSION_COOKIE_SECURE=0

# Identifiant administrateur
SASTOUKASTORE_ADMIN_USER=Admin

# Sel administrateur
SASTOUKASTORE_ADMIN_SALT=CHANGE_ME_WITH_A_RANDOM_SALT

# Hash SHA-256 du mot de passe administrateur
CHARIOW_ADMIN_HASH=CHANGE_ME_WITH_SHA256_HASH

# ------------------------------------------------------------------
# PayPal
# ------------------------------------------------------------------
# La version actuelle de SastoukaStore charge encore les identifiants
# PayPal depuis secret.json.
#
# NE COPIEZ PAS les identifiants PayPal dans ce fichier.
# Lors de la préparation du dépôt GitHub, secret.json doit rester local
# et être exclu de Git.
#
# Migration future possible :
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=live
# PAYPAL_CURRENCY=EUR
